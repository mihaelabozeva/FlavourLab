# Copy this file to .env and adjust the values.
# The project runs without a .env file (SQLite, debug on).

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database: leave DB_NAME empty to use SQLite (default).
# Fill these in only if you want to use PostgreSQL.
DB_NAME=
DB_USER=
DB_PASS=
DB_HOST=localhost
DB_PORT=5432